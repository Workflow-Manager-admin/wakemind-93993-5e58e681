<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="24dp">

    <!-- Challenge Title -->
    <TextView
        android:id="@+id/challengeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/solve_challenge"
        android:textSize="20sp"
        android:textColor="@color/text_primary_dark"
        android:textAlignment="center"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Challenge Type -->
    <TextView
        android:id="@+id/challengeType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/math_challenge"
        android:textSize="16sp"
        android:textColor="@color/accent_yellow"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/challengeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Math Challenge Layout -->
    <LinearLayout
        android:id="@+id/mathChallengeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/challengeType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/mathQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 + 5 = ?"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_dark"
            android:layout_marginBottom="32dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/mathOption1"
                style="@style/ChallengeButton"
                android:text="8"
                android:layout_margin="8dp" />

            <Button
                android:id="@+id/mathOption2"
                style="@style/ChallengeButton"
                android:text="10"
                android:layout_margin="8dp" />

            <Button
                android:id="@+id/mathOption3"
                style="@style/ChallengeButton"
                android:text="12"
                android:layout_margin="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Pattern Challenge Layout -->
    <LinearLayout
        android:id="@+id/patternChallengeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/challengeType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/patternInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_pattern"
            android:textSize="18sp"
            android:textColor="@color/text_primary_dark"
            android:layout_marginBottom="24dp" />

        <!-- Pattern Grid -->
        <GridLayout
            android:id="@+id/patternGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="3">

            <Button
                android:id="@+id/pattern1"
                style="@style/ChallengeButton"
                android:layout_margin="4dp" />
            <Button
                android:id="@+id/pattern2"
                style="@style/ChallengeButton"
                android:layout_margin="4dp" />
            <Button
                android:id="@+id/pattern3"
                style="@style/ChallengeButton"
                android:layout_margin="4dp" />
            <Button
                android:id="@+id/pattern4"
                style="@style/ChallengeButton"
                android:layout_margin="4dp" />
            <Button
                android:id="@+id/pattern5"
                style="@style/ChallengeButton"
                android:layout_margin="4dp" />
            <Button
                android:id="@+id/pattern6"
                style="@style/ChallengeButton"
                android:layout_margin="4dp" />
            <Button
                android:id="@+id/pattern7"
                style="@style/ChallengeButton"
                android:layout_margin="4dp" />
            <Button
                android:id="@+id/pattern8"
                style="@style/ChallengeButton"
                android:layout_margin="4dp" />
            <Button
                android:id="@+id/pattern9"
                style="@style/ChallengeButton"
                android:layout_margin="4dp" />

        </GridLayout>

    </LinearLayout>

    <!-- Feedback Text -->
    <TextView
        android:id="@+id/feedbackText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/mathChallengeLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
